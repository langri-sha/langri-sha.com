"""
Workspace checks that have no official module: TypeScript, projen and package
manifests.
"""
type Ci {
  """
  The workspace source.
  """
  pub source: Directory!

  """
  The base image to use.
  """
  pub baseImageAddress: String!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:24-slim",
  ) {
    self.source = ws.directory("/", exclude: [".git"])
    self.baseImageAddress = baseImageAddress
    self
  }

  """
  Type-check every project reference.
  """
  pub typescript: Void @check {
    base.withExec(["pnpm", "tsc", "--build", "."]).sync

    null
  }

  """
  Synthesize the projen configuration.
  """
  pub projen: Changeset! @generate {
    base
      .withExec(["pnpm", "projen"])
      .directory("/src")
      .filter(exclude: installed)
      .changes(source)
  }

  """
  Sort and fix the package manifests.
  """
  pub packages: Changeset! @generate {
    base
      .withExec([
        "pnpm", "dlx", "sort-package-json@latest",
        "package.json", "apps/*/package.json", "packages/*/package.json",
      ])
      .withExec(["pnpm", "-r", "exec", "npm", "pkg", "fix"])
      .directory("/src")
      .filter(include: ["**/package.json"], exclude: installed)
      .changes(source.filter(include: ["**/package.json"]))
  }

  """
  Paths that installing and building create, which the workspace ignores.
  """
  let installed: [String!]! = [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/.tsbuild",
    "**/*.tsbuildinfo",
  ]

  """
  The workspace with its dependencies installed.
  """
  let base: Container! {
    container
      .from(baseImageAddress)
      .withMountedCache("/pnpm/store", cacheVolume("pnpm-store"))
      .withEnvVariable("npm_config_store_dir", "/pnpm/store")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("HUSKY", "0")
      .withExec(["corepack", "enable"])
      .withDirectory("/src", source)
      .withWorkdir("/src")
      .withExec(["pnpm", "install", "--frozen-lockfile"])
  }
}
