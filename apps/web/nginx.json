{
  "port": 8080,
  "scenarios": [
    {
      "name": "responses",
      "requests": [
        {
          "path": "/",
          "status": 200,
          "headers": ["accept-encoding: gzip", "via: 1.1 google"],
          "responseHeaders": [
            "cache-control: public, max-age=0, s-maxage=86400, must-revalidate",
            "content-encoding: gzip",
            "x-robots-tag: noindex"
          ]
        },
        {
          "path": "/manifest.webmanifest",
          "status": 200,
          "responseHeaders": [
            "content-type: application/manifest+json",
            "x-robots-tag: noindex"
          ]
        },
        {
          "path": "/no-such-page",
          "status": 404,
          "bodyContains": ["Nothing dwells here"],
          "responseHeaders": ["x-robots-tag: noindex"]
        },
        {
          "path": "/no-such-page/",
          "status": 404
        },
        {
          "path": "/llms.txt",
          "status": 200,
          "bodyContains": ["# Langri-Sha"],
          "responseHeaders": ["content-type: text/plain"]
        },
        {
          "path": "/robots.txt",
          "status": 200,
          "bodyContains": [
            "User-Agent: *",
            "Allow: /",
            "Sitemap: https://langri-sha.com/sitemap.xml"
          ],
          "responseHeaders": [
            "content-type: text/plain",
            "x-robots-tag: noindex"
          ]
        },
        {
          "path": "/sitemap.xml",
          "status": 200,
          "bodyContains": ["<loc>https://langri-sha.com/</loc>"],
          "responseHeaders": ["content-type: text/xml", "x-robots-tag: noindex"]
        }
      ]
    }
  ]
}
